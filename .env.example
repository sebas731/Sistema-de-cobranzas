# Plantilla de variables de entorno. Copia este archivo como .env y pon tus valores.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# El archivo .env real NO se sube al repo (está en .gitignore).

# Clave secreta de Django. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=pon-aqui-una-clave-secreta-larga-y-unica

# En producción va en False. En tu PC de desarrollo, True.
DEBUG=False

# Dominios/IPs permitidos, separados por coma. Ej: midominio.com,www.midominio.com,123.45.67.89
ALLOWED_HOSTS=
